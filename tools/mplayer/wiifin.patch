--- /dev/null
+++ b/mplayer/wiifin/register_mpegts.c
@@ -0,0 +1,16 @@
+/* WiiFin calls this before playing: registers FFmpeg's MPEG-TS demuxer
+ * (Jellyfin's streams) once, for -demuxer lavf. */
+#include "libavformat/avformat.h"
+
+extern AVInputFormat ff_mpegts_demuxer;
+
+void register_mpegts_demuxer(void);
+
+void register_mpegts_demuxer(void)
+{
+    AVInputFormat *f = NULL;
+    while ((f = av_iformat_next(f)))
+        if (f == &ff_mpegts_demuxer)
+            return;
+    av_register_input_format(&ff_mpegts_demuxer);
+}
diff --git a/mplayer/wiifin/wii_stubs.c b/mplayer/wiifin/wii_stubs.c
new file mode 100644
index 0000000000000000000000000000000000000000..8539749fd34a5a89c011a3be11134c55196c9f5f
--- /dev/null
+++ b/mplayer/wiifin/wii_stubs.c
@@ -0,0 +1,70 @@
+/* What MPlayer CE's Wii build links to but devkitPro no longer provides,
+ * or WiiFin does not use: iconv (an identity copy), the PPC-specific init
+ * hooks of FFmpeg (no AltiVec on the Wii), a cache flush and NTFS. */
+#include <stdbool.h>
+#include <stddef.h>
+#include <string.h>
+#include <gctypes.h>
+#include <ogc/disc_io.h>
+
+typedef void *iconv_t;
+
+iconv_t iconv_open(const char *tocode, const char *fromcode)
+{
+    (void)tocode; (void)fromcode;
+    return (iconv_t)-1;
+}
+
+/* Copies as many bytes as fit, unconverted. */
+size_t iconv(iconv_t cd, char **inbuf, size_t *inbytesleft,
+             char **outbuf, size_t *outbytesleft)
+{
+    (void)cd;
+    if (!inbuf || !*inbuf || !outbuf || !*outbuf)
+        return 0;
+    size_t copy = *inbytesleft < *outbytesleft ? *inbytesleft : *outbytesleft;
+    memcpy(*outbuf, *inbuf, copy);
+    *inbuf += copy;
+    *inbytesleft -= copy;
+    *outbuf += copy;
+    *outbytesleft -= copy;
+    return 0;
+}
+
+int iconv_close(iconv_t cd)
+{
+    (void)cd;
+    return 0;
+}
+
+void DCBlockFlush(void *ptr)
+{
+    __asm__ volatile ("dcbf 0,%0" : : "r"(ptr) : "memory");
+}
+
+struct FmtConvertContext;
+struct AVCodecContext;
+struct H264DSPContext;
+
+void ff_fmt_convert_init_ppc(struct FmtConvertContext *c, struct AVCodecContext *avctx)
+{
+    (void)c; (void)avctx;
+}
+
+void ff_h264dsp_init_ppc(struct H264DSPContext *c, const int bit_depth, const int chroma_format_idc)
+{
+    (void)c; (void)bit_depth; (void)chroma_format_idc;
+}
+
+bool ntfsMount(const char *name, const DISC_INTERFACE *interface, sec_t startSector,
+               u32 cachePageCount, u32 cachePageSize, u32 flags)
+{
+    (void)name; (void)interface; (void)startSector;
+    (void)cachePageCount; (void)cachePageSize; (void)flags;
+    return false;
+}
+
+void ntfsUnmount(const char *name, bool commit)
+{
+    (void)name; (void)commit;
+}
